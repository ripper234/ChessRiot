# Public runtime values. Secrets belong in the Site's secret manager, never here.
CHESSRIOT_ENV=development
APP_ORIGIN=https://dev.chessriot.gg
CONTROL_ORIGIN=https://control.chessriot.gg

# Required secret names: ACCOUNT_ID_SECRET, OBSERVABILITY_HASH_SECRET,
# OPS_READ_SECRET, VAPID_PRIVATE_JWK, and VIDEO_REGEN_SHARED_SECRET.
# Optional capability secrets: OPENAI_API_KEY.
# Public push values: VAPID_PUBLIC_KEY and VAPID_SUBJECT.
