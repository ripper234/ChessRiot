{
  "name": "chessriot-control",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "build": "bash scripts/build.sh",
    "test": "node --test tests/*.test.mjs",
    "validate": "node scripts/validate-artifact.mjs",
    "release:check": "node scripts/release-version.mjs check",
    "release:patch": "node scripts/release-version.mjs patch",
    "release:minor": "node scripts/release-version.mjs minor",
    "release:major": "node scripts/release-version.mjs major",
    "db:generate": "drizzle-kit generate"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
