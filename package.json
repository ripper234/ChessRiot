{
  "name": "chessriot",
  "version": "0.17.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "build:artifact": "bash scripts/build-artifact.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "bash scripts/sites-env.sh -- tsc --noEmit",
    "test": "bash scripts/sites-env.sh -- vitest run --maxWorkers=2",
    "test:e2e": "npm run build:artifact && npm run test:e2e:built",
    "test:e2e:built": "bash scripts/sites-env.sh -- node tests/e2e-local.mjs",
    "test:render": "npm run build:artifact && npm run test:render:built",
    "test:render:built": "bash scripts/sites-env.sh -- node --test tests/rendered-html.test.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "release:patch": "node scripts/release-version.mjs patch",
    "release:minor": "node scripts/release-version.mjs minor",
    "release:major": "node scripts/release-version.mjs major",
    "release:check": "node scripts/release-version.mjs check"
  },
  "dependencies": {
    "chess.js": "1.4.0",
    "drizzle-orm": "0.45.2",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-push-neo": "0.1.2"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "brace-expansion": "1.1.17",
    "postcss": "8.5.25",
    "sharp": "0.35.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.50.0",
    "@cloudflare/workers-types": "5.20260801.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.32",
    "drizzle-kit": "0.31.10",
    "eslint": "10.8.0",
    "eslint-config-next": "16.2.12",
    "react-server-dom-webpack": "19.2.8",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.0",
    "vitest": "3.2.7",
    "wrangler": "4.118.0"
  }
}
